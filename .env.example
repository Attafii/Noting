# Vercel project env vars — copy to .env.local for dev, set in Vercel dashboard for prod
GLOBAL_SECRET_TOKEN=replace-with-your-secure-random-string
NEON_CONNECTION_STRING=postgresql://user:pass@host/db?sslmode=require
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# Optional model overrides (defaults shown):
# OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_EMBED_MODEL=baai/bge-m3
# Cloudflare Turnstile fallback (free Managed widget, lazy-loaded only when the
# built-in tile puzzle fails; happy path touches no third party):
# 1. dash.cloudflare.com → Turnstile → Add widget (Managed mode), hostnames:
#    noting-notes.vercel.app (+ localhost for dev). Copy the sitekey + secret.
# 2. Dev test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITEKEY=replace-with-your-turnstile-sitekey
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret
# Optional comma-separated hostname allowlist for siteverify (defaults shown):
# TURNSTILE_ALLOWED_HOSTNAMES=noting-notes.vercel.app,localhost,127.0.0.1
