{
  "rewrites": [
    { "source": "/api/ai", "destination": "/api/router?route=ai" },
    { "source": "/api/ask", "destination": "/api/router?route=ask" },
    { "source": "/api/documents", "destination": "/api/router?route=documents" },
    { "source": "/api/download", "destination": "/api/router?route=download" },
    { "source": "/api/folders", "destination": "/api/router?route=folders" },
    { "source": "/api/hint", "destination": "/api/router?route=hint" },
    { "source": "/api/note", "destination": "/api/router?route=note" },
    { "source": "/api/notes", "destination": "/api/router?route=notes" },
    { "source": "/api/revisions", "destination": "/api/router?route=revisions" },
    { "source": "/api/token-question", "destination": "/api/router?route=token-question" },
    { "source": "/api/tokens", "destination": "/api/router?route=tokens" },
    { "source": "/api/upload", "destination": "/api/router?route=upload" },
    { "source": "/api/usage", "destination": "/api/router?route=usage" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/router.ts": { "memory": 1024, "maxDuration": 30 },
    "api/challenge.ts": { "memory": 256, "maxDuration": 10 },
    "api/health.ts": { "memory": 256, "maxDuration": 10 }
  }
}
